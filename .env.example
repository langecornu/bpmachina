# BPMachina configuration (all optional)
PORT=4100
# Address to listen on. The default (127.0.0.1) keeps the app on this computer. 0.0.0.0 opens it to your network, where
# anyone who can reach it can spend your Anthropic key.
# HOST=127.0.0.1
# Comma-separated list of allowed browser origins (the Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5180
# Anthropic API key for the AI composer. Optional: it can also be pasted on the Settings screen, where it is never
# shown again
# ANTHROPIC_API_KEY=
# Where the song JSON is stored
DATA_DIR=server/data
# development | production | test (production switches log output to JSON)
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info
# text | json (default: text in development, json in production)
# LOG_FORMAT=text
