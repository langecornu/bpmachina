{
  "name": "bpmachina",
  "version": "0.1.0",
  "description": "BPMachina: compose music with an AI composer you direct, then shape every note by hand, in the browser.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --import ./tests/server/setup.js --test tests/server/*.test.js",
    "test:web": "vitest run",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:web",
    "test:coverage:server": "node --import ./tests/server/setup.js --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=85 tests/server/*.test.js",
    "test:coverage:web": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.js",
    "licenses": "node scripts/check-licenses.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dsp": "node scripts/build-dsp.js",
    "measure:dsp": "node scripts/measure-dsp.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@grame/faustwasm": "0.20.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.4.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
